WORKDIR = $PWD

CC = gcc
CXX = g++
AR = ar
LD = g++
WINDRES = windres

INC = 
CFLAGS = -Werror -Wshadow -Wextra -Wall -ggdb -fexceptions --std=c++17
RCFLAGS = 
RESINC = 
LIBDIR = 
LIB = 
LDFLAGS = 

INC_LINUX = $(INC) -I../wincompat
CFLAGS_LINUX = $(CFLAGS) -O3 -pthread
RESINC_LINUX = $(RESINC)
RCFLAGS_LINUX = $(RCFLAGS)
LIBDIR_LINUX = $(LIBDIR)
LIB_LINUX = $(LIB) -ldl
LDFLAGS_LINUX = $(LDFLAGS) -pthread
OBJDIR_LINUX = build/obj
DEP_LINUX = 
OUT_LINUX = build/fbdump

OBJ_LINUX = $(OBJDIR_LINUX)/tstring.o $(OBJDIR_LINUX)/status.o $(OBJDIR_LINUX)/reader.o $(OBJDIR_LINUX)/main.o $(OBJDIR_LINUX)/__/wincompat/libloaderapi.o $(OBJDIR_LINUX)/journal.o $(OBJDIR_LINUX)/format.o $(OBJDIR_LINUX)/dumper.o $(OBJDIR_LINUX)/detector.o $(OBJDIR_LINUX)/charsets.o

all: linux

clean: clean_linux

before_linux: 
	test -d build || mkdir -p build
	test -d $(OBJDIR_LINUX) || mkdir -p $(OBJDIR_LINUX)
	test -d $(OBJDIR_LINUX)/__/wincompat || mkdir -p $(OBJDIR_LINUX)/__/wincompat

after_linux: 

linux: before_linux out_linux after_linux

out_linux: before_linux $(OBJ_LINUX) $(DEP_LINUX)
	$(LD) $(LIBDIR_LINUX) -o $(OUT_LINUX) $(OBJ_LINUX)  $(LDFLAGS_LINUX) $(LIB_LINUX)

$(OBJDIR_LINUX)/tstring.o: tstring.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c tstring.cpp -o $(OBJDIR_LINUX)/tstring.o

$(OBJDIR_LINUX)/status.o: status.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c status.cpp -o $(OBJDIR_LINUX)/status.o

$(OBJDIR_LINUX)/reader.o: reader.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c reader.cpp -o $(OBJDIR_LINUX)/reader.o

$(OBJDIR_LINUX)/main.o: main.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c main.cpp -o $(OBJDIR_LINUX)/main.o

$(OBJDIR_LINUX)/__/wincompat/libloaderapi.o: ../wincompat/libloaderapi.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c ../wincompat/libloaderapi.cpp -o $(OBJDIR_LINUX)/__/wincompat/libloaderapi.o

$(OBJDIR_LINUX)/journal.o: journal.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c journal.cpp -o $(OBJDIR_LINUX)/journal.o

$(OBJDIR_LINUX)/format.o: format.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c format.cpp -o $(OBJDIR_LINUX)/format.o

$(OBJDIR_LINUX)/dumper.o: dumper.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c dumper.cpp -o $(OBJDIR_LINUX)/dumper.o

$(OBJDIR_LINUX)/detector.o: detector.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c detector.cpp -o $(OBJDIR_LINUX)/detector.o

$(OBJDIR_LINUX)/charsets.o: charsets.cpp
	$(CXX) $(CFLAGS_LINUX) $(INC_LINUX) -c charsets.cpp -o $(OBJDIR_LINUX)/charsets.o

clean_linux: 
	rm -f $(OBJ_LINUX) $(OUT_LINUX)
	rm -rf build
	rm -rf $(OBJDIR_LINUX)
	rm -rf $(OBJDIR_LINUX)/__/wincompat

.PHONY: before_linux after_linux clean_linux

